# Copy to .env (never commit .env) and fill in real values.

# --- Server ---
PORT=5000
# Comma-separated list of browser origins allowed to call this API.
ALLOWED_ORIGINS=https://mavisolution.com,https://www.mavisolution.com,http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Paste your provider's CA certificate to enable real TLS verification.
# Without it the server falls back to an unverified connection and logs a warning.
DATABASE_CA_CERT=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Mailgun ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
ADMIN_EMAIL=

# --- Google Sheets webhook ---
# Redeploy the Apps Script to get a fresh URL; the old one is public in git history.
GOOGLE_SHEETS_WEBHOOK_URL=
# Optional shared secret; have the Apps Script reject requests without it.
SHEETS_WEBHOOK_TOKEN=
