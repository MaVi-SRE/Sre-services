# ---------------------------------------------------------------------------
# Frontend (browser) — only VITE_-prefixed vars reach the browser.
# ---------------------------------------------------------------------------
# Leave BLANK in production: the API runs as serverless functions in this same
# Vercel project, so the app calls /api/* on the same domain. Set this only to
# point at a different backend (e.g. a local `vercel dev`).
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Server (Vercel Serverless Functions in /api) — NEVER exposed to the browser.
# Add these in the Vercel project's Environment Variables (not VITE_-prefixed).
# ---------------------------------------------------------------------------
# Gemini (get an AIza… key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres / Supabase connection string (required for lead + contact-form saves)
DATABASE_URL=
# Optional: paste the provider CA cert to enable strict TLS verification.
DATABASE_CA_CERT=

# Optional: email notifications via Mailgun (skipped if unset)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
ADMIN_EMAIL=

# Optional: Google Sheets webhook for the contact form (skipped if unset)
GOOGLE_SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# Optional: set to 1 to include the real error in /api/chat responses (debug only)
DEBUG_CHAT=
